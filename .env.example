[BACKEND]
MONGODB_URI=mongodb://localhost:27017/medibridge
JWT_SECRET=your-super-secret-jwt-key-change-in-production
PORT=5000

[FRONTEND]
# Base URL of the backend API. If unset, the frontend uses a relative /api path
# that is proxied by Next.js rewrites to BACKEND_URL (or localhost:5000 in dev).
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Origin of the backend used by the Next.js /api rewrite (no trailing /api).
# Only needed when the backend is NOT reachable at localhost:5000, e.g. in
# production: BACKEND_URL=https://your-backend.example.com
# BACKEND_URL=
